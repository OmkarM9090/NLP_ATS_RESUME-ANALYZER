# ---------------------------------------------------------------------------
# Frontend environment (copy to `.env.local`)
# ---------------------------------------------------------------------------

# Server-side proxy target used by next.config.mjs rewrites.
# Docker Compose: http://backend:8000     Local dev: http://127.0.0.1:8000
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Same-origin prefix the browser calls. Leave as /api unless the backend is
# served from a different origin (which then requires CORS configuration).
NEXT_PUBLIC_API_BASE_URL=/api

NEXT_PUBLIC_APP_NAME=ATS Resume Matcher
NEXT_PUBLIC_APP_VERSION=1.0.0

# Upload limits mirrored from the backend so the UI can reject early.
NEXT_PUBLIC_MAX_FILE_SIZE_MB=10
NEXT_PUBLIC_ALLOWED_EXTENSIONS=.pdf,.txt,.docx
