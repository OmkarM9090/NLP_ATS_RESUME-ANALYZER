# ---------------------------------------------------------------------------
# ATS Resume Matcher — backend configuration
# Copy to `.env` and adjust. Every key maps 1:1 onto `backend/config.py`.
# ---------------------------------------------------------------------------

# -- Application ------------------------------------------------------------ #
APP_NAME="ATS Resume Matcher"
APP_VERSION=1.0.0
ENVIRONMENT=development          # development | staging | production
DEBUG=false
API_PREFIX=/api

# -- Server ----------------------------------------------------------------- #
HOST=0.0.0.0
PORT=8000
WORKERS=1
ANALYSIS_TIMEOUT_SECONDS=60

# -- CORS ------------------------------------------------------------------- #
# Comma separated list, or a JSON array.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true
# Extra regex-matched origins (sandbox previews, feature branches, ...).
# Leave empty to rely on CORS_ORIGINS only.
CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1|0\.0\.0\.0|\[::1\])(:\d+)?$|https?://.*\.e2b\.app$

# -- Uploads ---------------------------------------------------------------- #
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=[".pdf",".txt",".docx"]
MIN_EXTRACTED_CHARS=50

# -- Database --------------------------------------------------------------- #
# Defaults to sqlite+aiosqlite:///<backend>/var/ats_history.db
# DATABASE_URL=sqlite+aiosqlite:///./var/ats_history.db
DB_ECHO=false
HISTORY_PAGE_SIZE=20
HISTORY_MAX_PAGE_SIZE=100
HISTORY_RETENTION_DAYS=90

# -- NLP models ------------------------------------------------------------- #
SPACY_MODEL=en_core_web_lg
SPACY_FALLBACK_MODELS=["en_core_web_sm","en_core_web_md"]
SPACY_MAX_LENGTH=2000000
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
SENTENCE_TRANSFORMER_DEVICE=cpu
SEMANTIC_CHUNK_SIZE=512
ENABLE_SEMANTIC_SIMILARITY=true
# Load models at startup (first request is then fast). Set false for lazy load.
ENABLE_EAGER_MODEL_LOAD=true
# Allow downloading spaCy/HuggingFace weights at runtime. Leave 0 in air-gapped
# deployments — the offline heuristic pipeline + TF-IDF/LSA encoder take over.
ATS_ALLOW_MODEL_DOWNLOAD=0

# -- OCR fallback (scanned PDFs) -------------------------------------------- #
ENABLE_OCR_FALLBACK=true
OCR_LANGUAGES=eng
OCR_DPI=300
OCR_MAX_PAGES=10

# -- Scoring weights (must sum to 1.0; re-normalised automatically) --------- #
WEIGHT_KEYWORD_MATCH=0.25
WEIGHT_SEMANTIC_SIMILARITY=0.30
WEIGHT_SKILL_MATCH=0.25
WEIGHT_EXPERIENCE_RELEVANCE=0.10
WEIGHT_EDUCATION_MATCH=0.10

# -- Keyword / skill tuning ------------------------------------------------- #
TFIDF_NGRAM_MIN=1
TFIDF_NGRAM_MAX=3
TOP_KEYWORDS=30
RAKE_TOP_KEYWORDS=20
SKILL_FUZZY_THRESHOLD=85
SKILL_SEMANTIC_THRESHOLD=0.72
KEYWORD_DENSITY_TARGET_LOW=0.05
KEYWORD_DENSITY_TARGET_HIGH=0.60

# -- Score calibration (raw cosine -> 0-100 via 1 - exp(-x / tau)) ---------- #
KEYWORD_COSINE_TAU=0.20
SEMANTIC_TAU_TRANSFORMER=0.25
SEMANTIC_TAU_LSA=0.15

# -- Rate limiting ---------------------------------------------------------- #
ANALYZE_RATE_LIMIT=10/minute
DEFAULT_RATE_LIMIT=60/minute
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=memory://   # redis://host:6379 for multi-worker deploys

# -- Logging ---------------------------------------------------------------- #
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                     # true = single-line structured JSON logs
